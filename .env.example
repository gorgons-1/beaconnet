# Copy to .env (scripts/install.sh does this for you) and adjust. No secrets go in here:
# tokens and SSH host keys live in secrets/ and are generated by the installer.

# --- node ---------------------------------------------------------------------------
# The node id must be unique across the whole mesh - peers address mail as user@NODE-ID.
# Pattern REGION-PLACE-NN, e.g. SCOT-OBAN-01, WALES-CONWY-01, US-TX-AUSTIN-01 (or a callsign).
# The installer asks for it on a first install. A-Z 0-9 and '-', 3-32 characters.
BBS_NODE_ID=BEACON-HUB-01
BBS_NODE_NAME=                       # blank = use node.name from config/bbs.yaml
BBS_VERSION=dev                      # set by install.sh/update.sh from the VERSION file

# Host name or IP users type to reach this node (shown in help and instructions).
# The installer fills in this machine's LAN address.
BBS_PUBLIC_HOST=bbs.example.org

# --- public BBS SSH -----------------------------------------------------------------
BBS_SSH_BIND=0.0.0.0                 # address on the Pi the BBS listens on
BBS_SSH_PORT=2222                    # users connect with: ssh -p 2222 guest@<host>
BBS_MAX_CONN_PER_IP=4
BBS_MAX_CONN_TOTAL=64

# --- administration console ---------------------------------------------------------
# 127.0.0.1 = only reachable from the Pi itself (log in to the Pi, then ssh -p 2223 ...),
# or from your PC through a tunnel:  ssh -L 2223:127.0.0.1:2223 <you>@<pi>
# To use a dedicated management interface instead, set its IP here. Never 0.0.0.0.
BBS_ADMIN_BIND=127.0.0.1
BBS_ADMIN_PORT=2223

# --- mesh links to other nodes (bbs-sync) -------------------------------------------
# Peers dial this port; only node keys listed in config/peers.yaml are let in. If this
# node is behind NAT and nobody can reach it, that's fine: it dials out to its peers.
BBS_SYNC_BIND=0.0.0.0
BBS_SYNC_PORT=2224
# Host/IP peers should dial, written into this node's peer card. Blank = BBS_PUBLIC_HOST.
# Set to "-" if this node can't be reached from outside (it will dial its peers instead).
BBS_SYNC_PUBLIC_HOST=
BBS_SYNC_INTERVAL=300                # seconds between routine syncs with each peer

# --- software updates (scripts/update.sh) --------------------------------------------
# A weekly timer checks GitHub for a new release and shows it in the admin console.
# true = also install it automatically (a backup is taken first). Off by default:
# a node should change only when its sysop chooses.
BBS_AUTO_UPDATE=false

# --- storage and backups ------------------------------------------------------------
BBS_BACKUP_DIR=/var/backups/scotland-bbs   # host directory (on the NVMe), owned by uid 10001
BACKUP_KEEP_DAYS=14                        # daily backups kept locally
BACKUP_TIME=03:15                          # systemd OnCalendar time for the daily backup
# Optional off-site copy after each backup, via rsync over SSH (blank = none), e.g.
#   BACKUP_REMOTE=backup@nas.example.org:/srv/backups/scotland-bbs/
BACKUP_REMOTE=

# --- logging ------------------------------------------------------------------------
BBS_LOG_LEVEL=INFO
# Container log rotation per service. Blank = 10m x 5; the installer sets 2m x 3 when the
# system runs from an SD card.
BBS_LOG_MAX_SIZE=
BBS_LOG_MAX_FILES=
